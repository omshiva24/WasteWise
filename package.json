{
  "name": "wastewise",
  "version": "1.0.0",
  "description": "WasteWise - smart waste pickup management for supervisors, vendors, admins and members. Web (PWA), Android and iOS from one codebase.",
  "private": true,
  "type": "module",
  "author": "P Om Shiva (M.Tech CSE, Pondicherry University) <https://github.com/omshiva24>",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/dev-server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "check": "node scripts/check.mjs",
    "native:add": "npx cap add android && npx cap add ios",
    "native:sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  }
}
