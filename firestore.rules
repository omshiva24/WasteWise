rules_version = '2';

// WasteWise Firestore security rules - paste these into
// Firebase console > Firestore Database > Rules, then Publish.
//
// - The first account ever created becomes the admin (recorded in meta/setup).
// - Everyone else joins as a member and may *request* supervisor / vendor access;
//   only an admin can change roles.
// - The request lifecycle (OPEN -> ACCEPTED -> COMPLETED, or OPEN -> CANCELLED)
//   is enforced here as well as in the app (public/js/core/lifecycle.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function setupPath() { return /databases/$(database)/documents/meta/setup; }
    function profile() { return get(userPath(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(userPath(request.auth.uid)); }
    function role() { return hasProfile() && profile().active == true ? profile().role : 'none'; }
    function isAdmin() { return role() == 'admin'; }
    function isSupervisor() { return role() == 'supervisor'; }
    function isVendor() { return role() == 'vendor'; }
    function data() { return request.resource.data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function nowMs() { return request.time.toMillis(); }
    function recent(t) { return t is number && t > nowMs() - 600000 && t < nowMs() + 600000; }
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(v, max) { return v == null || str(v, max); }
    function wasteType(v) { return v in ['plastic', 'organic', 'paper', 'glass', 'metal', 'ewaste', 'hazardous', 'mixed']; }
    function geoOk(g) {
      return g == null || (g is map && g.keys().hasOnly(['lat', 'lng', 'acc'])
        && g.lat is number && g.lat >= -90 && g.lat <= 90
        && g.lng is number && g.lng >= -180 && g.lng <= 180
        && (g.acc == null || g.acc is number));
    }
    function profileOk(d) {
      return d.keys().hasOnly(['name', 'email', 'phone', 'company', 'role', 'requestedRole', 'active', 'createdAt', 'fcmTokens'])
        && str(d.name, 60) && d.name.size() >= 2
        && str(d.email, 120) && str(d.phone, 20) && str(d.company, 60)
        && d.active == true && recent(d.createdAt);
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && profileOk(data()) && (
        // normal sign-up: member, optionally asking for supervisor / vendor access
        (data().role == 'member' && (data().requestedRole == null || data().requestedRole in ['supervisor', 'vendor'])
          && exists(setupPath()))
        // the very first account becomes the admin (in the same batch as meta/setup)
        || (data().role == 'admin' && data().requestedRole == null
          && !exists(setupPath()) && getAfter(setupPath()).data.adminUid == request.auth.uid)
      );
      allow update: if isAdmin()
        || (request.auth.uid == uid
          && !changed().hasAny(['role', 'active', 'email', 'createdAt'])
          && str(data().name, 60) && data().name.size() >= 2 && str(data().phone, 20) && str(data().company, 60)
          && (!changed().hasAny(['requestedRole'])
            || (resource.data.role == 'member' && (data().requestedRole == null || data().requestedRole in ['supervisor', 'vendor']))));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- one-time setup marker
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && data().adminUid == request.auth.uid && recent(data().at)
        && getAfter(userPath(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    // Request code counter (WR-1001, WR-1002 ...): may only go up by one.
    match /meta/counters {
      allow read: if hasProfile();
      allow create: if (isSupervisor() || isAdmin()) && data().requests == 1002;
      allow update: if (isSupervisor() || isAdmin()) && data().requests == resource.data.requests + 1;
    }

    // ---------------------------------------------------------------- waste requests
    match /requests/{id} {
      allow read: if hasProfile();

      allow create: if isSupervisor()
        && data().keys().hasOnly(['wasteType', 'binId', 'location', 'zone', 'notes', 'priority', 'estKg', 'geo', 'hasPhoto', 'code',
            'status', 'createdBy', 'createdByName', 'createdByPhone', 'createdAt', 'updatedAt', 'acceptedAt', 'vendorId', 'vendorName',
            'vendorPhone', 'completedAt', 'weightKg', 'rating', 'overdue', 'history'])
        && data().status == 'OPEN'
        && data().createdBy == request.auth.uid
        && wasteType(data().wasteType)
        && str(data().binId, 24)
        && str(data().location, 80) && data().location.size() >= 2
        && str(data().zone, 80)
        && str(data().notes, 280)
        && data().priority in ['normal', 'urgent']
        && (data().estKg == null || (data().estKg is number && data().estKg >= 0 && data().estKg <= 50000))
        && geoOk(data().geo)
        && str(data().code, 16)
        && optStr(data().createdByPhone, 20)
        && data().vendorId == null
        && data().weightKg == null
        && data().history is list && data().history.size() == 1
        && recent(data().createdAt);

      allow update: if
        // vendor accepts an open request (a transaction prevents double-accepts)
        (isVendor() && resource.data.status == 'OPEN' && data().status == 'ACCEPTED'
          && data().vendorId == request.auth.uid
          && optStr(data().vendorPhone, 20)
          && recent(data().acceptedAt)
          && changed().hasOnly(['status', 'vendorId', 'vendorName', 'vendorPhone', 'acceptedAt', 'history', 'updatedAt']))
        // vendor releases a pickup they accepted
        || (isVendor() && resource.data.status == 'ACCEPTED' && resource.data.vendorId == request.auth.uid
          && data().status == 'OPEN' && data().vendorId == null
          && changed().hasOnly(['status', 'vendorId', 'vendorName', 'vendorPhone', 'acceptedAt', 'history', 'updatedAt']))
        // supervisor confirms handover of their own request
        || (isSupervisor() && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'ACCEPTED' && data().status == 'COMPLETED'
          && data().weightKg is number && data().weightKg > 0 && data().weightKg <= 50000
          && (data().rating == null || (data().rating is int && data().rating >= 1 && data().rating <= 5))
          && recent(data().completedAt)
          && changed().hasOnly(['status', 'weightKg', 'rating', 'completedAt', 'overdue', 'history', 'updatedAt']))
        // supervisor cancels their own open request
        || (isSupervisor() && resource.data.createdBy == request.auth.uid
          && resource.data.status == 'OPEN' && data().status == 'CANCELLED'
          && changed().hasOnly(['status', 'overdue', 'history', 'updatedAt']))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // Request photos live in their own documents so lists stay fast.
    match /photos/{rid} {
      allow read: if hasProfile();
      allow create: if isSupervisor() && data().by == request.auth.uid
        && str(data().data, 600000) && data().data.matches('^data:image/.*')
        && getAfter(/databases/$(database)/documents/requests/$(rid)).data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- bins
    match /bins/{binId} {
      allow read: if hasProfile();
      allow create, update: if isAdmin() && str(data().location, 80) && geoOk(data().geo) && wasteType(data().wasteType);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- audit log (append-only)
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if hasProfile() && data().actor == request.auth.uid && recent(data().at)
        && str(data().action, 40) && str(data().detail, 160);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- notifications
    // Written by the app when something happens to someone else's request or account.
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if hasProfile() && data().from == request.auth.uid
        && data().keys().hasOnly(['to', 'from', 'title', 'body', 'requestId', 'kind', 'at', 'read'])
        && str(data().to, 128) && str(data().title, 80) && str(data().body, 160) && str(data().kind, 20)
        && data().read == false && recent(data().at);
      allow update: if signedIn() && resource.data.to == request.auth.uid && changed().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.to == request.auth.uid;
    }
  }
}
